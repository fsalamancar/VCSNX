# The boot splash (platform/switch/boot_splash*): the "studios bAlo" logo of the port's author, cut
# into pieces and layers by tools/make_splash.py into assets/splash/, and its sound.wav from
# tools/make_splash_sound.py. Their bytes are built into the game, so nothing has to be copied to the
# SD card; without the logo the game starts straight away, without the sound the splash is silent.
# Sets VCSNX_HAS_SPLASH and VCSNX_SPLASH_SOURCES.
set(VCSNX_SPLASH_DIR "${CMAKE_SOURCE_DIR}/assets/splash")
set(VCSNX_SPLASH_SOURCES "")
set(VCSNX_HAS_SPLASH OFF)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${VCSNX_SPLASH_DIR}/splash.png" "${VCSNX_SPLASH_DIR}/splash_pieces.inc" "${VCSNX_SPLASH_DIR}/sound.wav")
if(EXISTS "${VCSNX_SPLASH_DIR}/splash.png" AND EXISTS "${VCSNX_SPLASH_DIR}/splash_pieces.inc")
    file(READ "${VCSNX_SPLASH_DIR}/splash.png" vcsnx_splash_hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," vcsnx_splash_bytes "${vcsnx_splash_hex}")
    file(READ "${VCSNX_SPLASH_DIR}/splash_pieces.inc" vcsnx_splash_pieces)
    set(vcsnx_splash_sound_bytes "0x00,")
    set(vcsnx_splash_sound_size "0")
    if(EXISTS "${VCSNX_SPLASH_DIR}/sound.wav")
        file(READ "${VCSNX_SPLASH_DIR}/sound.wav" vcsnx_splash_hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," vcsnx_splash_sound_bytes "${vcsnx_splash_hex}")
        set(vcsnx_splash_sound_size "sizeof(kSplashWav)")
    endif()
    set(vcsnx_splash_data "${CMAKE_BINARY_DIR}/generated_splash/splash_data.cpp")
    file(WRITE "${vcsnx_splash_data}.new"
        "// Generated by cmake/vcsnx_splash.cmake from assets/splash/; do not edit.\n"
        "#include \"boot_splash_sdl.hpp\"\n\nnamespace vcsnx {\n\n"
        "const unsigned char kSplashPng[] = {${vcsnx_splash_bytes}};\n"
        "const std::size_t kSplashPngSize = sizeof(kSplashPng);\n"
        "const unsigned char kSplashWav[] = {${vcsnx_splash_sound_bytes}};\n"
        "const std::size_t kSplashWavSize = ${vcsnx_splash_sound_size};\n"
        "const SplashPiece kSplashPieces[] = {\n${vcsnx_splash_pieces}};\n"
        "const std::size_t kSplashPieceCount = sizeof(kSplashPieces) / sizeof(kSplashPieces[0]);\n\n"
        "} // namespace vcsnx\n")
    # Rewritten only when it changed, so reconfiguring does not rebuild the game.
    configure_file("${vcsnx_splash_data}.new" "${vcsnx_splash_data}" COPYONLY)
    set(VCSNX_HAS_SPLASH ON)
    set(VCSNX_SPLASH_SOURCES
        "${VCSNX_PLATFORM_DIR}/boot_splash.cpp" "${VCSNX_PLATFORM_DIR}/boot_splash_sdl.cpp" "${vcsnx_splash_data}")
    message(STATUS "VCSNX: boot splash from ${VCSNX_SPLASH_DIR}")
else()
    message(STATUS "VCSNX: no assets/splash/, the game starts without a splash (see tools/make_splash.py)")
endif()
